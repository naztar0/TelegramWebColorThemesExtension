{
  "name": "Telegram Web Color Themes",
  "version": "1.1.0",
  "manifest_version": 3,
  "description": "Change theme color for Telegram Web",
  "author": "Neulen",
  "homepage_url": "https://web.telegram.org/a/",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon19.png",
    "default_title": "View panel",
    "default_popup": "src/popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://weba.telegram.org/*",
    "https://web.telegram.org/a/*"
  ],
  "content_scripts": [
    {
      "matches": [ "https://weba.telegram.org/*", "https://web.telegram.org/a/*" ],
      "js": [ "src/js/inject.js" ],
      "run_at": "document_start"
    }
  ]
}
